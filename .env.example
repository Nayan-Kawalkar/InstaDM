# Any random string you make up — you'll type the same one into the Meta dashboard
VERIFY_TOKEN=my-secret-verify-123

# Instagram app secret (API setup page) and/or Facebook App secret (App settings > Basic).
# Not sure which one Meta uses? Put both, comma-separated: secretA,secretB
APP_SECRET=

# Long-lived Instagram User access token (generated in the same dashboard page)
IG_ACCESS_TOKEN=

# Your Instagram professional account ID (shown next to the token in the dashboard)
IG_USER_ID=
